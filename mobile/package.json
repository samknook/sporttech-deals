{
  "name": "trizentro-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test-model.mjs",
    "android:init": "npm run build && cap add android",
